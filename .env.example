# Copy to .env.local for development. In Vercel, set these per environment (Preview -> dev project, Production -> prod project).

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only, never expose

# Which site this deployment serves (Work Hays = site #1)
NEXT_PUBLIC_SITE_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without a key, emails are printed to the terminal instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Work Hays <hello@mail.workhays.com>"

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron sends this as a Bearer token to /api/cron/daily (any long random string)
CRON_SECRET=

# Legacy migration only (scripts/migrate-legacy)
LEGACY_MYSQL_URL=
TARGET_DATABASE_URL=
